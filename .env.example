# --- Base de données ---
DB_ROOT_PASSWORD=change_moi_mot_de_passe_root
DB_NAME=lamaison
DB_USER=lamaison_user
DB_PASSWORD=change_moi_mot_de_passe

# --- Backend ---
# Origine(s) autorisée(s) à appeler l'API (celles du frontend et de l'admin en prod).
# Plusieurs origines séparées par une virgule, sans espace.
CORS_ORIGIN=http://localhost:8080,http://localhost:8081
CLERK_SECRET_KEY=sk_xxx
CLERK_PUBLISHABLE_KEY=pk_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# --- Frontend / Admin (build-time) ---
# URL PUBLIQUE et joignable du backend (pas "http://backend:5000" !).
# En local avec ce compose : http://localhost:5000
PUBLIC_API_URL=http://localhost:5000